# Environment variables to set in Render (Backend) for production.
# Do NOT commit real values. Fill in each one in Render > Environment.

NODE_ENV=production
# PORT is set by Render automatically

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/expense-tracker?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your exact Vercel URL, no trailing slash (comma-separate for several)
CLIENT_URL=https://your-app.vercel.app

# Required in production: without email, nobody can verify their email or reset a password.
# Render free tier BLOCKS SMTP, so send via a Google Apps Script relay (see backend/mail-relay/Code.gs):
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
# SMTP fallback (works on paid Render or locally):
# Gmail: smtp.gmail.com / 587 / your address / a Google "App password"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Expense Tracker <no-reply@yourdomain.com>"

# Profile images: Render's disk is wiped on every deploy, so store them on Cloudinary (free tier).
# Leave empty locally to keep saving to backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
