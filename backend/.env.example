PORT=8000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/expense-tracker?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Email (used to send OTP codes). If SMTP_HOST is empty in development, codes are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Expense Tracker <no-reply@example.com>"

# Profile images: Render's disk is wiped on every deploy, so store them on Cloudinary (free tier).
# Leave empty locally to keep saving to backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
